name: Deployment

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Deploy
        uses: shopware/github-actions/project-deployer@main
        with:
          sshPrivateKey: ${{ secrets.SSH_PRIVATE_KEY }}
          phpVersion: '[[ .PHPVersion ]]'
