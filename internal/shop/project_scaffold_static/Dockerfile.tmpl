#syntax=docker/dockerfile:1.10

# Generated by shopware-cli. Builds the project into a production image:
#
#   docker buildx build --load -t my-shop .
#
# Private packages (Shopware Store, private Packagist) are passed as a build
# secret instead of being baked into the image:
#
#   docker buildx build --load --secret id=composer_auth,src=auth.json -t my-shop .

ARG PHP_VERSION={{ .PHPVersion }}
FROM ghcr.io/shopware/docker-base:${PHP_VERSION}-frankenphp AS base-image
FROM ghcr.io/shopware/shopware-cli:latest-php-${PHP_VERSION} AS shopware-cli

FROM shopware-cli AS build

ADD . /src
WORKDIR /src

ENV SHOPWARE_CACHE_ID=docker

RUN --mount=type=secret,id=packages_token,env=SHOPWARE_PACKAGES_TOKEN \
    --mount=type=secret,id=composer_auth,dst=/src/auth.json \
    --mount=type=cache,target=/root/.composer \
    --mount=type=cache,target=/root/.npm \
    /usr/local/bin/entrypoint.sh shopware-cli project ci /src{{ if .WithDevDependencies }} --with-dev-dependencies{{ end }}

FROM base-image AS final

ENV SHOPWARE_DISABLE_UPDATE_CHECK=1

COPY --from=build --chown=82 --link /src /var/www/html
