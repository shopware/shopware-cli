#syntax=docker/dockerfile:1.4

# Generated by shopware-cli. Builds the project into a production image:
#
#   docker build -t my-shop .
#
# Private packages (Shopware Store, private Packagist) are passed as a build
# secret instead of being baked into the image:
#
#   docker build --secret id=composer_auth,src=auth.json -t my-shop .

FROM ghcr.io/shopware/docker-base:{{ .PHPVersion }} AS base-image
FROM ghcr.io/shopware/shopware-cli:latest-php-{{ .PHPVersion }} AS shopware-cli

FROM shopware-cli AS build

ARG SHOPWARE_PACKAGES_TOKEN

ADD . /src
WORKDIR /src

ENV SHOPWARE_CACHE_ID=docker

RUN --mount=type=secret,id=composer_auth,dst=/src/auth.json \
    --mount=type=cache,target=/root/.composer \
    --mount=type=cache,target=/root/.npm \
    /usr/local/bin/entrypoint.sh shopware-cli project ci /src

FROM base-image

ENV SHOPWARE_DISABLE_UPDATE_CHECK=1

COPY --from=build --chown=82 --link /src /var/www/html
