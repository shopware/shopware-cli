name: Check

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  check:
    runs-on: ubuntu-latest

    steps:
      - name: Project Validate
        uses: shopware/github-actions/project-validate@main
        with:
          phpVersion: '{{ .PHPVersion }}'

  # Checks that the production Administration and Storefront build succeeds.
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '{{ .PHPVersion }}'

      - name: Install Shopware CLI
        uses: shopware/shopware-cli-action@v3

      - name: Build Project
        uses: shopware/build-project-action@v1
